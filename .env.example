PROJECT_NAME=
BACKEND_PORT=
MOCK_API_PORT=
WEB_APP_PORT=
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
# Адрес сайта ACT, который бот подставляет в кнопку результатов теста.
# ВАЖНО: его открывает телефон родителя, а не сама машина с docker compose,
# поэтому http://localhost:<WEB_APP_PORT> для реального показа не подходит —
# кнопка просто не откроется на телефоне. Варианты, которые работают:
#   1) LAN-адрес компьютера в той же Wi-Fi сети, например
#      http://192.168.1.42:<WEB_APP_PORT> (узнать IP: ipconfig / ifconfig);
#      порт mini-app-service в docker-compose.yml уже не привязан к 127.0.0.1,
#      так что снаружи он доступен;
#   2) туннель (ngrok и т.п.) — тогда сюда идёт его публичный https-адрес.
WEB_APP_URL=